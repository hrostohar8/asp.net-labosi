@model TicketingSystemFightNight.Models.ViewModels.EventEditViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_Layout";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a> /
    <a asp-controller="Event" asp-action="Index">Događaji</a> /
    <span>Uredi događaj</span>
</nav>

<h2>Uredi događaj</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input asp-for="Id" type="hidden" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="OrganizationId"></label>
        <select asp-for="OrganizationId" class="form-control" asp-items="ViewBag.OrganizationList"></select>
        <span asp-validation-for="OrganizationId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="City"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <div class="form-group">
        @await Html.PartialAsync("_DateTimePicker", new { fieldName = "Date", fieldLabel = "Datum i vrijeme", value = (Model != null && Model.Date.Year > 1 ? (DateTime?)Model.Date.Add(Model.Time) : null), isRequired = true, includeTime = true, timeFieldName = "Time" })
        <span asp-validation-for="Time" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="VenueId"></label>
        @await Html.PartialAsync("_AutocompleteDropdown", new { fieldName = "VenueId", fieldLabel = "Arena", ajaxUrl = Url.Action("SearchArenas", "Arena"), placeholder = "Pretraži arene...", selectedId = (ViewBag.SelectedVenue != null ? (int?)ViewBag.SelectedVenue.Id : null), selectedText = (ViewBag.SelectedVenue != null ? (string)ViewBag.SelectedVenue.Text : ""), isRequired = true })
        <span asp-validation-for="VenueId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BaseTicketPrice"></label>
        <input asp-for="BaseTicketPrice" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="BaseTicketPrice" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TicketsSold"></label>
        <input asp-for="TicketsSold" type="number" class="form-control" />
        <span asp-validation-for="TicketsSold" class="text-danger"></span>
    </div>

    <button type="submit" class="btn">Spremi</button>
    <a class="btn" asp-controller="Event" asp-action="Index">Odustani</a>
</form>

<hr class="my-4" />
<div class="row mt-3">
    <div class="col-md-12">
        <h4>Privici događaja</h4>
        <p class="text-muted">Dodajte dokumente, slike ili druge datoteke vezane uz ovaj događaj. Maksimalna veličina: 10MB.</p>

        <form id="attachmentDz"
              action="/Event/UploadAttachment?eventId=@Model.Id"
              enctype="multipart/form-data"
              class="dropzone border border-secondary rounded p-3 mb-3"
              style="min-height: 120px;">
            <div class="dz-message text-center text-muted py-3">
                <i class="bi bi-cloud-upload fs-1"></i>
                <br />
                <span>Povucite datoteke ovdje ili kliknite za odabir</span>
            </div>
        </form>

        <div id="attachmentList">
            @await Html.PartialAsync("_AttachmentList", (IEnumerable<TicketingSystemFightNight.Models.EventAttachment>)ViewBag.EventAttachments)
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.js"></script>

    <script type="text/javascript">
        Dropzone.autoDiscover = false;

        var myDropzone = new Dropzone("#attachmentDz", {
            paramName: "file",
            maxFilesize: 10,
            acceptedFiles: ".pdf,.jpg,.jpeg,.png,.gif,.doc,.docx,.txt,.zip",
            addRemoveLinks: true,
            dictDefaultMessage: "Povucite datoteke ovdje ili kliknite za upload",
            dictRemoveFile: "Ukloni",
            dictMaxFilesExceeded: "Ne možete uploadati više datoteka.",
            success: function(file, response) {
                loadAttachments();
                this.removeFile(file);
            },
            error: function(file, errorMessage) {
                alert("Greška pri uploadu: " + (typeof errorMessage === 'string' ? errorMessage : errorMessage.title || 'Nepoznata greška'));
                this.removeFile(file);
            }
        });

        function loadAttachments() {
            $("#attachmentList").load("/Event/GetAttachments?eventId=@Model.Id");
        }

        function deleteAttachment(id) {
            if (!confirm("Jeste li sigurni da želite obrisati ovu datoteku?")) return;

            $.ajax({
                url: "/Event/DeleteAttachment",
                method: "POST",
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        loadAttachments();
                    }
                },
                error: function() {
                    alert("Greška pri brisanju datoteke.");
                }
            });
        }
    </script>
}
