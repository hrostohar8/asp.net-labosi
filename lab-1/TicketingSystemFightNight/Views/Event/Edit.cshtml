@model TicketingSystemFightNight.Models.Event
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_Layout";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a> /
    <a asp-controller="Event" asp-action="Index">Događaji</a> /
    <span>Uredi događaj</span>
</nav>

<h2>Uredi događaj</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Organization"></label>
        <select asp-for="Organization" class="form-control" asp-items="Html.GetEnumSelectList<TicketingSystemFightNight.Models.FightOrganization>()"></select>
        <span asp-validation-for="Organization" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="City"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Date"></label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Time"></label>
        <input asp-for="Time" type="time" class="form-control" />
        <span asp-validation-for="Time" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Arena</label>
        <select asp-for="VenueId" class="form-control" asp-items="ViewBag.ArenaList"></select>
        <span asp-validation-for="VenueId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BaseTicketPrice"></label>
        <input asp-for="BaseTicketPrice" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="BaseTicketPrice" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TicketsSold"></label>
        <input asp-for="TicketsSold" type="number" class="form-control" />
        <span asp-validation-for="TicketsSold" class="text-danger"></span>
    </div>

    <button type="submit" class="btn">Spremi</button>
    <a class="btn" asp-controller="Event" asp-action="Details" asp-route-id="@Model.Id">Odustani</a>
</form>
