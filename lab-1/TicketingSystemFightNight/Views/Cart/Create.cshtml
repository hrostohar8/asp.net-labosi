@model TicketingSystemFightNight.Models.ViewModels.CartCreateViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "_Layout";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a> /
    <a asp-controller="Cart" asp-action="Index">Košarice</a> /
    <span>Dodaj košaricu</span>
</nav>

<h2>Dodaj košaricu</h2>

<form asp-action="Create" method="post">`r`n    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="form-group">
        <label asp-for="UserId"></label>
        @await Html.PartialAsync("_AutocompleteDropdown", new { fieldName = "UserId", fieldLabel = "Korisnik", ajaxUrl = Url.Action("SearchUsers", "User"), placeholder = "Pretraži korisnike...", selectedId = (ViewBag.SelectedUser != null ? (int?)ViewBag.SelectedUser.Id : null), selectedText = (ViewBag.SelectedUser != null ? (string)ViewBag.SelectedUser.Text : ""), isRequired = true })
        <span asp-validation-for="UserId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DiscountCode"></label>
        <input asp-for="DiscountCode" class="form-control" />
        <span asp-validation-for="DiscountCode" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DiscountPercent"></label>
        <input asp-for="DiscountPercent" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="DiscountPercent" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IsPaid"></label>
        <input asp-for="IsPaid" type="checkbox" class="form-check-input" />
        <span asp-validation-for="IsPaid" class="text-danger"></span>
    </div>

    <button type="submit" class="btn">Spremi</button>
    <a asp-controller="Cart" asp-action="Index" class="btn">Odustani</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
