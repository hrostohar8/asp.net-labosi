@{
    Layout = "_Layout";
}

@model List<TicketingSystemFightNight.Models.Match>

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a> /
    <span>Mečevi</span>
</nav>

<h2>Pregled - Mečevi</h2>
<a asp-controller="Match" asp-action="Create" class="btn">Dodaj meč</a>

<div class="table-filter-wrap" data-ajax-url="@Url.Action("SearchMatches", "Match")">
    <div class="table-filter-controls">
        <input type="search" class="table-search" placeholder="Pretraži mečeve..." aria-label="Pretraži mečeve" />
        <span class="table-results-counter">0 results found</span>
    </div>
    <div class="entity-grid">
    @foreach (var match in Model)
    {
        <article class="entity-card">
            <h3>@match.Fighter1?.Name vs @match.Fighter2?.Name</h3>
            <div class="entity-props">
                <p><strong>Id:</strong> @match.Id</p>
                <p><strong>Borac 1:</strong> @match.Fighter1?.Name</p>
                <p><strong>Borac 2:</strong> @match.Fighter2?.Name</p>
                <p><strong>Težinska klasa:</strong> @match.WeightClass?.Name</p>
                <p><strong>Događaj:</strong> @match.Event?.Name</p>
                <p><strong>Runde:</strong> @match.RoundLimit</p>
                <p><strong>Šampionski:</strong> @(match.Championship ? "Da" : "Ne")</p>
                <p><strong>Sudac:</strong> @match.Referee</p>
                <p><strong>Status:</strong> @match.Status</p>
            </div>
            <div class="entity-actions">
                <a class="btn" asp-controller="Match" asp-action="Details" asp-route-id="@match.Id">Detalji</a>
                <a class="btn" asp-controller="Match" asp-action="Edit" asp-route-id="@match.Id">Uredi</a>
                <form asp-controller="Match" asp-action="Delete" asp-route-id="@match.Id" method="post" class="inline-form" onsubmit="return confirm('Jeste li sigurni da želite obrisati ovaj meč?');">
                    <button type="submit" class="btn btn-danger">Obriši</button>
                </form>
            </div>
        </article>
    }
    </div>
</div>

@section Scripts{
    <script src="~/js/match-search.js"></script>
}
