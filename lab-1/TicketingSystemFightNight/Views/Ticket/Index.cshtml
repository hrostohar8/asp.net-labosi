@{
    Layout = "_Layout";
}

@model TicketingSystemFightNight.Models.TicketShopViewModel

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a> /
    <span>Karte</span>
</nav>

<h2>Kupnja ulaznica</h2>

@if (TempData["CartMessage"] != null)
{
    <div class="alert success">@TempData["CartMessage"]</div>
}

<div class="ticket-shop-grid">
    @foreach (var offer in Model.Offers)
    {
        <article class="ticket-offer-card">
            <header>
                <h3>@offer.Title</h3>
                <span class="ticket-tag">@offer.EventName</span>
            </header>
            <p class="ticket-description">@offer.Description</p>
            <ul class="ticket-specs">
                <li><strong>Lokacija:</strong> @offer.Location</li>
                <li><strong>Sektor:</strong> @offer.Section</li>
                <li><strong>Red:</strong> @offer.Row</li>
                <li><strong>Sjedište:</strong> @offer.Seat</li>
                <li><strong>VIP:</strong> @(offer.IsVip ? "Da" : "Ne")</li>
            </ul>
            <div class="ticket-footer">
                <strong class="ticket-price">@offer.PriceDisplay</strong>
                <form asp-action="AddToCart" method="post" asp-antiforgery="true">
                    <input type="hidden" name="offerId" value="@offer.Id" />
                    <button type="submit" class="btn btn-primary">Dodaj u košaricu</button>
                </form>
            </div>
        </article>
    }
</div>

<section class="cart-summary">
    <h3>Košarica</h3>
    @if (Model.CartItems.Any())
    {
        <p>Ukupno stavki: <strong>@Model.CartCount</strong></p>
        <ul>
            @foreach (var item in Model.CartItems)
            {
                <li>
                    <strong>@item.Title</strong> - @item.Section @item.Row@item.Seat, @item.PriceDisplay
                </li>
            }
        </ul>
        <p class="cart-total">Ukupno: <strong>@Model.CartTotal.ToString("C")</strong></p>
    }
    else
    {
        <p>Košarica je prazna. Dodajte kartu kako biste nastavili s kupnjom.</p>
    }
</section>
