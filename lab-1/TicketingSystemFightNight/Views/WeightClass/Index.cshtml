@{
    Layout = "_Layout";
}

@model List<TicketingSystemFightNight.Models.WeightClass>

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a> /
    <span>Kategorije težine</span>
</nav>

<h2>Pregled kategorija težine</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card">
    <div class="card-body">
        <a asp-action="Create" class="btn btn-primary mb-3">
            <i class="bi bi-plus-circle"></i> Dodaj kategoriju
        </a>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Naziv</th>
                        <th>Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var weightClass in Model)
                    {
                        <tr>
                            <td>@weightClass.Id</td>
                            <td>@weightClass.Name</td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary me-2" asp-action="Edit" asp-route-id="@weightClass.Id">
                                    <i class="bi bi-pencil"></i> Uredi
                                </a>
                                <form asp-action="Delete" asp-route-id="@weightClass.Id" method="post" class="d-inline" onsubmit="return confirm('Jeste li sigurni da želite obrisati ovu kategoriju težine?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Obriši
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
