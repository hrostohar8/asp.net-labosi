@model TicketingSystemFightNight.Models.ViewModels.UserCreateViewModel
@{
    Layout = "_Layout";
}

<nav class="breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Početna</a> /
    <a asp-controller="User" asp-action="Index">Korisnici</a> /
    <span>Dodaj korisnika</span>
</nav>

<h2>Dodaj korisnika</h2>

<form asp-action="Create" method="post">`r`n    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="form-group">
        @await Html.PartialAsync("_DateTimePicker", new { fieldName = "BirthDate", fieldLabel = "Datum rođenja", value = (Model != null && Model.BirthDate.Year > 1 ? (DateTime?)Model.BirthDate : null), isRequired = true, includeTime = false })
    </div>

    <div class="form-group">
        <label asp-for="LoyaltyPoints"></label>
        <input asp-for="LoyaltyPoints" type="number" class="form-control" />
        <span asp-validation-for="LoyaltyPoints" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IsVip"></label>
        <input asp-for="IsVip" type="checkbox" class="form-check-input" />
        <span asp-validation-for="IsVip" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MemberLevel"></label>
        <input asp-for="MemberLevel" class="form-control" />
        <span asp-validation-for="MemberLevel" class="text-danger"></span>
    </div>

    <button type="submit" class="btn">Spremi</button>
    <a asp-controller="User" asp-action="Index" class="btn">Odustani</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
