{
  "$schema": "https://raw.githubusercontent.com/github/copilot-docs/main/docs/schemas/agent-hooks-schema.json",
  "name": "Conversation Logger",
  "description": "Automatically logs all user prompts and agent responses to agent_log.txt",
  "version": "1.0.0",
  "hooks": {
    "UserPromptSubmit": {
      "enabled": true,
      "description": "Logs user prompts when submitted",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".github/hooks/log-conversation.ps1",
        "-role",
        "USER",
        "-message",
        "{userMessage}"
      ]
    },
    "PreToolUse": {
      "enabled": true,
      "description": "Logs tool usage before tool execution",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".github/hooks/log-conversation.ps1",
        "-role",
        "TOOL",
        "-message",
        "Alat: {toolName} | Parametri: {toolInput}"
      ]
    }
  }
}
